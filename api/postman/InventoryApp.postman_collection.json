                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/items/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "items",
                "{{itemId}}"
              ]
            },
            "description": "Run Get item first. Sending an old version returns 409.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"A4 paper, 80gsm\",\n  \"category\": \"Stationery\",\n  \"reorderLevel\": 15,\n  \"unitPrice\": 5.25,\n  \"version\": {{itemVersion}}\n}",
